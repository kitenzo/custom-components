{% comment %}
  Kitenzo custom component: an outfit set builder (one piece per step, size and colour each).

  Install: upload kitenzo-activewear-set.js and kitenzo-activewear-set.css (from `bun run build:embed`) to the
  theme's assets/ folder, and this file to sections/. Then add the section to a product template
  (see INSTALL.md and MERCHANT-SETUP.md in the install kit).

  Everything a merchant might want to change is a setting below, not code: every heading, label
  and message, and the accent colours. What to sell (steps, products, counts, prices, discounts)
  is not, because it comes from the bundle in Kitenzo.
{% endcomment %}

{{ 'kitenzo-activewear-set.css' | asset_url | stylesheet_tag }}

{%- liquid
  # Which bundle to render. Kitenzo writes each bundle's id onto its own Shopify product as the
  # `bundle-builder.bundle-id` metafield, so a product IS a bundle reference: "This product" reads
  # it off the page's product, "Selected bundle" off a picked one. A draft bundle's product never
  # appears in the picker, so the "Unpublished bundle ID" box is the way to design against one.
  # This is the same resolution as Kitenzo's own app block.
  assign bundle_source = section.settings.bundle_source | default: 'current_product'
  if bundle_source == 'current_product'
    assign resolved_bundle_id = product.metafields.bundle-builder.bundle-id | append: '' | strip
  else
    assign resolved_bundle_id = section.settings.bundle_product.metafields.bundle-builder.bundle-id | append: '' | strip
  endif
  if resolved_bundle_id == blank
    assign resolved_bundle_id = section.settings.bundle_id | append: '' | strip
  endif
-%}

{%- if resolved_bundle_id == blank -%}
  {%- comment -%}
    Nothing to render. The storefront shows nothing; only the merchant, in the theme editor, is
    told why. Styled inline because the storefront never paints it.
  {%- endcomment -%}
  {%- if request.design_mode -%}
    <div style="margin: 16px; padding: 16px; border: 1px solid #f1c27d; border-radius: 8px; background: #fff4e5; color: #4a3410; font: 14px/1.5 -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;">
      This product is not a Kitenzo bundle, so this section shows nothing on the storefront. Put
      the section on a bundle product's template, or set "Bundle source" to "Selected bundle" and
      pick one. A draft bundle will not appear in the picker: paste its ID into "Unpublished
      bundle ID" instead.
    </div>
  {%- endif -%}
{%- else -%}
  {%- comment -%}
    The theme's own fonts, so the widget looks like the rest of the store and follows it when the
    merchant changes them. Most themes name these settings type_body_font and type_header_font;
    check yours. When the theme has neither, the widget inherits the page's font.
  {%- endcomment -%}
  {%- liquid
    assign body_font = settings.type_body_font
    assign heading_font = settings.type_header_font
  -%}
  <style>
    {%- if body_font %}
    {{ body_font | font_face: font_display: 'swap' }}
    {{ body_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
    {%- endif %}
    {%- if heading_font %}
    {{ heading_font | font_face: font_display: 'swap' }}
    {%- endif %}
    #kitenzo-{{ section.id }} {
      {%- if body_font %} --aws-font-body: {{ body_font.family }}, {{ body_font.fallback_families }};{% endif %}
      {%- if heading_font %} --aws-font-heading: {{ heading_font.family }}, {{ heading_font.fallback_families }};{% endif %}
      {%- if section.settings.accent_color != blank %} --aws-accent: {{ section.settings.accent_color }};{% endif %}
      {%- if section.settings.accent_contrast_color != blank %} --aws-accent-contrast: {{ section.settings.accent_contrast_color }};{% endif %}
    }
  </style>

  {%- comment -%}
    The settings as one JSON blob, captured and then escaped once.

    `json` escapes for JSON, not for an HTML attribute: an apostrophe passes straight through and
    would close a single-quoted attribute early, losing every string to one "Maman's". Escaping
    the captured blob fixes that, and the browser decodes it back to exact JSON before the widget
    reads it.

    Every string goes through `default: ''` first: a cleared text setting reaches Liquid as nil,
    and `nil | json` is `null`, which the widget would ignore anyway; this keeps the blob honest.
  {%- endcomment -%}
  {%- capture kitenzo_content -%}
    {
      "heading": {{ section.settings.heading | default: '' | json }},
      "intro": {{ section.settings.intro | default: '' | json }},
      "addToCart": {{ section.settings.add_to_cart | default: '' | json }},
      "adding": {{ section.settings.adding | default: '' | json }},
      "added": {{ section.settings.added | default: '' | json }},
      "chooseMore": {{ section.settings.choose_more | default: '' | json }},
      "chooseMoreStep": {{ section.settings.choose_more_step | default: '' | json }},
      "stepOptional": {{ section.settings.step_optional | default: '' | json }},
      "stepFull": {{ section.settings.step_full | default: '' | json }},
      "bundleFull": {{ section.settings.bundle_full | default: '' | json }},
      "soldOut": {{ section.settings.sold_out | default: '' | json }},
      "onlyLeft": {{ section.settings.only_left | default: '' | json }},
      "stockReached": {{ section.settings.stock_reached | default: '' | json }},
      "variantLimit": {{ section.settings.variant_limit | default: '' | json }},
      "productLimit": {{ section.settings.product_limit | default: '' | json }},
      "included": {{ section.settings.included | default: '' | json }},
      "summaryHeading": {{ section.settings.summary_heading | default: '' | json }},
      "summaryNotChosen": {{ section.settings.summary_not_chosen | default: '' | json }},
      "setPrice": {{ section.settings.set_price | default: '' | json }},
      "total": {{ section.settings.total | default: '' | json }},
      "saving": {{ section.settings.saving | default: '' | json }},
      "add": {{ section.settings.add | default: '' | json }},
      "inSet": {{ section.settings.in_set | default: '' | json }},
      "inSetAgain": {{ section.settings.in_set_again | default: '' | json }},
      "swapped": {{ section.settings.swapped | default: '' | json }},
      "remove": {{ section.settings.remove | default: '' | json }},
      "details": {{ section.settings.details | default: '' | json }},
      "close": {{ section.settings.close | default: '' | json }},
      "chooseOption": {{ section.settings.choose_option | default: '' | json }},
      "optionSoldOut": {{ section.settings.option_sold_out | default: '' | json }},
      "optionSoldOutWith": {{ section.settings.option_sold_out_with | default: '' | json }},
      "optionRepaired": {{ section.settings.option_repaired | default: '' | json }},
      "surchargeNote": {{ section.settings.surcharge_note | default: '' | json }},
      "surchargeLine": {{ section.settings.surcharge_line | default: '' | json }},
      "matchHeading": {{ section.settings.match_heading | default: '' | json }},
      "matchDone": {{ section.settings.match_done | default: '' | json }},
      "matchBlocked": {{ section.settings.match_blocked | default: '' | json }},
      "notMadeIn": {{ section.settings.not_made_in | default: '' | json }},
      "swatchOptions": {{ section.settings.swatch_options | default: '' | json }},
      "swatchColours": {{ section.settings.swatch_colours | default: '' | json }},
      "notAllowed": {{ section.settings.not_allowed | default: '' | json }},
      "cartFailed": {{ section.settings.cart_failed | default: '' | json }},
      "retryAdd": {{ section.settings.retry_add | default: '' | json }},
      "unavailable": {{ section.settings.unavailable | default: '' | json }},
      "loadFailed": {{ section.settings.load_failed | default: '' | json }},
      "editNotice": {{ section.settings.edit_notice | default: '' | json }},
      "editMissing": {{ section.settings.edit_missing | default: '' | json }},
      "afterAdd": {{ section.settings.after_add | default: 'cart' | json }},
      "hidePrices": {{ section.settings.hide_prices | json }},
      "lowStockAt": {{ section.settings.low_stock_at | json }}
    }
  {%- endcapture -%}

  <div
    id="kitenzo-{{ section.id }}"
    data-activewear-set-bundle="{{ resolved_bundle_id | escape }}"
    data-api-key="{{ section.settings.api_key | strip | escape }}"
    data-shop-domain="{{ shop.permanent_domain | escape }}"
    data-country-code="{{ localization.country.iso_code | escape }}"
    data-root-url="{{ routes.root_url | escape }}"
    data-content="{{ kitenzo_content | escape }}"
  ></div>
  <script src="{{ 'kitenzo-activewear-set.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Kitenzo Activewear Set",
  "tag": "section",
  "class": "kitenzo-section",
  "settings": [
    {
      "type": "select",
      "id": "bundle_source",
      "label": "Bundle source",
      "options": [
        { "value": "current_product", "label": "This product (automatic)" },
        { "value": "manual", "label": "Selected bundle" }
      ],
      "default": "current_product",
      "info": "\"This product\" shows the bundle of whichever product this template is assigned to, so one template serves every bundle. Use \"Selected bundle\" on a page that is not a product."
    },
    {
      "type": "product",
      "id": "bundle_product",
      "label": "Selected bundle",
      "info": "Used when Bundle source is \"Selected bundle\". Pick the bundle's product."
    },
    {
      "type": "text",
      "id": "bundle_id",
      "label": "Unpublished bundle ID",
      "info": "A draft bundle does not appear in the picker. Paste its ID here to design against it in the theme editor. Leave blank once it is published."
    },
    {
      "type": "paragraph",
      "content": "Sells a set: one piece per step, each with its own size and colour. Works with set prices, variant surcharges and required products. Steps that take more than one piece, and bundles that ask for personalisation, need another section."
    },
    {
      "type": "text",
      "id": "api_key",
      "label": "Kitenzo headless API key",
      "info": "From Kitenzo, Settings, Headless. It starts kit_live_ and is public (it ships in the page, like every storefront key), so create it with this store's domains as its allowed origins."
    },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to use the bundle's name." },
    { "type": "textarea", "id": "intro", "label": "Introduction", "info": "Leave blank to use the bundle's description." },
    {
      "type": "select",
      "id": "after_add",
      "label": "After adding to the cart",
      "options": [
        { "value": "cart", "label": "Go to the cart" },
        { "value": "stay", "label": "Stay on this page" }
      ],
      "default": "cart",
      "info": "\"Stay\" suits themes with a cart drawer: the section fires a kitenzo:bundle-added event the drawer can listen for."
    },
    { "type": "checkbox", "id": "hide_prices", "label": "Hide prices", "default": false },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#121212" },
    { "type": "color", "id": "accent_contrast_color", "label": "Text on accent", "default": "#ffffff" },
    { "type": "header", "content": "Swatches" },
    {
      "type": "text",
      "id": "swatch_options",
      "label": "Options shown as swatches",
      "default": "Colour, Color",
      "info": "Product option names, separated by commas. Other options (Size) show as buttons. An option with Shopify swatches always shows as swatches."
    },
    {
      "type": "textarea",
      "id": "swatch_colours",
      "label": "Swatch colours",
      "default": "Onyx: #1d1d1f\nBone: #e4dccd\nMoss: #5b6447\nSlate: #5f6872",
      "info": "One per line, as \"Value: colour\" (a hex code such as #1d1d1f). A value not listed uses its Shopify swatch, then its own name if that is a colour (Black), then a photograph of the product in it."
    },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "add_to_cart", "label": "Add to cart", "default": "Add set to cart" },
    { "type": "text", "id": "adding", "label": "While adding", "default": "Adding…" },
    { "type": "text", "id": "added", "label": "Once added", "default": "Added to your cart" },
    { "type": "text", "id": "add", "label": "Add a piece", "default": "Add to set" },
    { "type": "text", "id": "in_set", "label": "Piece in the set", "default": "In your set" },
    { "type": "text", "id": "remove", "label": "Remove a piece", "default": "Remove" },
    { "type": "text", "id": "details", "label": "Product details", "default": "Details" },
    { "type": "text", "id": "close", "label": "Close", "default": "Close" },
    { "type": "header", "content": "Match colours" },
    { "type": "text", "id": "match_heading", "label": "Label", "default": "Match colours" },
    { "type": "text", "id": "match_done", "label": "Every piece matched", "default": "Every piece is now {value}.", "info": "{value} is the colour." },
    { "type": "text", "id": "match_blocked", "label": "Some pieces not matched", "default": "Not available in {value}:", "info": "Followed by each piece and the reason." },
    { "type": "text", "id": "not_made_in", "label": "Piece not made in a colour", "default": "Not made in {value}." },
    { "type": "header", "content": "Options" },
    { "type": "text", "id": "choose_option", "label": "Option not chosen", "default": "Choose your {option} first.", "info": "{option} is the option's name, such as size." },
    { "type": "text", "id": "option_sold_out", "label": "Value sold out", "default": "{value} is sold out." },
    { "type": "text", "id": "option_sold_out_with", "label": "Value sold out with a choice", "default": "{value} is sold out in {choice}.", "info": "{choice} is what the shopper chose before it, such as XS." },
    { "type": "text", "id": "option_repaired", "label": "Option changed to fit", "default": "{previous} is sold out in {choice}, so {option} is now {value}." },
    { "type": "text", "id": "surcharge_note", "label": "Surcharge on a piece", "default": "{value} adds {amount}", "info": "{value} is what carries the surcharge (Slate); {amount} is in the shopper's currency." },
    { "type": "text", "id": "in_set_again", "label": "Piece already in the set", "default": "This piece is in your set. Change its colour or size to swap it." },
    { "type": "text", "id": "swapped", "label": "Piece swapped", "default": "Swapped in your set: {value}", "info": "{value} is the new size and colour." },
    { "type": "header", "content": "Steps" },
    { "type": "text", "id": "step_optional", "label": "Optional step", "default": "Optional" },
    { "type": "text", "id": "step_full", "label": "Step is full", "default": "Your set already has a {step}. Remove it to choose this one.", "info": "{step} is the step's name." },
    { "type": "text", "id": "bundle_full", "label": "Set is full", "default": "Your set is full. Remove a piece to choose another." },
    { "type": "text", "id": "choose_more", "label": "More needed", "default": "Add {count} more to continue" },
    { "type": "text", "id": "choose_more_step", "label": "Steps still to choose", "default": "Still to choose: {step}", "info": "{step} is the steps' names." },
    { "type": "header", "content": "Products" },
    { "type": "text", "id": "sold_out", "label": "Sold out", "default": "Sold out" },
    { "type": "text", "id": "only_left", "label": "Low stock", "default": "Only {count} left", "info": "{count} is how many are left." },
    {
      "type": "range",
      "id": "low_stock_at",
      "label": "Low stock from",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 5,
      "info": "A piece with this many or fewer left in the chosen size and colour says so. Set it to 0 to never say it."
    },
    { "type": "text", "id": "stock_reached", "label": "No more stock", "default": "That is all we have of this one." },
    { "type": "text", "id": "variant_limit", "label": "Limit on one variant reached", "default": "That is the most of this one a set can hold." },
    { "type": "text", "id": "product_limit", "label": "Limit on one product reached", "default": "That is the most of this piece a set can hold." },
    { "type": "text", "id": "included", "label": "Included product", "default": "Included" },
    { "type": "header", "content": "Your set" },
    { "type": "text", "id": "summary_heading", "label": "Heading", "default": "Your set" },
    { "type": "text", "id": "summary_not_chosen", "label": "Step not chosen", "default": "Not chosen yet" },
    { "type": "text", "id": "set_price", "label": "Set price", "default": "Set price", "info": "Shown when the bundle has a set price." },
    { "type": "text", "id": "surcharge_line", "label": "Surcharge line", "default": "{step} in {value}", "info": "{step} is the step, {value} what carries the surcharge." },
    { "type": "text", "id": "total", "label": "Total", "default": "Total" },
    { "type": "text", "id": "saving", "label": "Saving", "default": "You save {amount} on the set", "info": "{amount} is the saving, in the shopper's currency." },
    { "type": "header", "content": "Messages" },
    { "type": "text", "id": "not_allowed", "label": "Selection not allowed", "default": "This combination cannot be bought as it is. Please change your selection.", "info": "Shown when a bundle rule other than a count refuses the selection." },
    { "type": "text", "id": "cart_failed", "label": "Add to cart failed", "default": "We could not add this to your cart. Please try again.", "info": "Shown when an add fails and the store gives no reason of its own." },
    { "type": "text", "id": "retry_add", "label": "Add interrupted", "default": "Press the button again to finish adding it; you will not be charged twice.", "info": "Shown after the connection drops while adding." },
    { "type": "text", "id": "unavailable", "label": "Set not available", "default": "This set is not available right now." },
    { "type": "text", "id": "load_failed", "label": "Set failed to load", "default": "We could not load this set. Please refresh the page to try again." },
    { "type": "textarea", "id": "edit_notice", "label": "Editing from the cart", "default": "You are editing a set from your cart. Adding it again replaces the one in your cart." },
    { "type": "textarea", "id": "edit_missing", "label": "Edited items no longer available", "default": "Some pieces from your saved set are no longer available, so please choose again." }
  ],
  "presets": [{ "name": "Kitenzo Activewear Set" }]
}
{% endschema %}
