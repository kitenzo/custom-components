{% comment %}
  Kitenzo custom component: theme section.

  Install: upload kitenzo-cocktail-case.js and kitenzo-cocktail-case.css (from `bun run build:embed`) to the
  theme's assets/ folder, and this file to sections/. Then add the section to a product template
  (see INSTALL.md and MERCHANT-SETUP.md in the install kit).

  Everything a merchant might want to change is a setting below, not code: every heading, label
  and message, which tag prefixes become filters, and the colours. What to sell (steps, products, counts, prices, discounts)
  is not, because it comes from the bundle in Kitenzo.
{% endcomment %}

{{ 'kitenzo-cocktail-case.css' | asset_url | stylesheet_tag }}

{%- liquid
  # Which bundle to render. Kitenzo writes each bundle's id onto its own Shopify product as the
  # `bundle-builder.bundle-id` metafield, so a product IS a bundle reference: "This product" reads
  # it off the page's product, "Selected bundle" off a picked one. A draft bundle's product never
  # appears in the picker, so the "Unpublished bundle ID" box is the way to design against one.
  # This is the same resolution as Kitenzo's own app block.
  assign bundle_source = section.settings.bundle_source | default: 'current_product'
  if bundle_source == 'current_product'
    assign resolved_bundle_id = product.metafields.bundle-builder.bundle-id | append: '' | strip
  else
    assign resolved_bundle_id = section.settings.bundle_product.metafields.bundle-builder.bundle-id | append: '' | strip
  endif
  if resolved_bundle_id == blank
    assign resolved_bundle_id = section.settings.bundle_id | append: '' | strip
  endif
-%}

{%- if resolved_bundle_id == blank -%}
  {%- comment -%}
    Nothing to render. The storefront shows nothing; only the merchant, in the theme editor, is
    told why. Styled inline because the storefront never paints it.
  {%- endcomment -%}
  {%- if request.design_mode -%}
    <div style="margin: 16px; padding: 16px; border: 1px solid #f1c27d; border-radius: 8px; background: #fff4e5; color: #4a3410; font: 14px/1.5 -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;">
      This product is not a Kitenzo bundle, so this section shows nothing on the storefront. Put
      the section on a bundle product's template, or set "Bundle source" to "Selected bundle" and
      pick one. A draft bundle will not appear in the picker: paste its ID into "Unpublished
      bundle ID" instead.
    </div>
  {%- endif -%}
{%- else -%}
  {%- comment -%}
    The theme's own fonts, so the widget looks like the rest of the store and follows it when the
    merchant changes them. Most themes name these settings type_body_font and type_header_font;
    check yours. When the theme has neither, the widget inherits the page's font.
  {%- endcomment -%}
  {%- liquid
    assign body_font = settings.type_body_font
    assign heading_font = settings.type_header_font
  -%}
  <style>
    {%- if body_font %}
    {{ body_font | font_face: font_display: 'swap' }}
    {{ body_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
    {%- endif %}
    {%- if heading_font %}
    {{ heading_font | font_face: font_display: 'swap' }}
    {%- endif %}
    #kitenzo-{{ section.id }} {
      {%- if body_font %} --ckc-font-body: {{ body_font.family }}, {{ body_font.fallback_families }};{% endif %}
      {%- if heading_font %} --ckc-font-heading: {{ heading_font.family }}, {{ heading_font.fallback_families }};{% endif %}
      {%- if section.settings.accent_color != blank %} --ckc-accent: {{ section.settings.accent_color }};{% endif %}
      {%- if section.settings.accent_contrast_color != blank %} --ckc-accent-contrast: {{ section.settings.accent_contrast_color }};{% endif %}
      --ckc-sticky-top: {{ section.settings.sticky_offset | default: 88 }}px;
      {%- if section.settings.case_color != blank %} --ckc-case: {{ section.settings.case_color }};{% endif %}
      {%- if section.settings.case_text_color != blank %} --ckc-case-ink: {{ section.settings.case_text_color }};{% endif %}
    }
  </style>

  {%- comment -%}
    The settings as one JSON blob, captured and then escaped once.

    `json` escapes for JSON, not for an HTML attribute: an apostrophe passes straight through and
    would close a single-quoted attribute early, losing every string to one "Maman's". Escaping
    the captured blob fixes that, and the browser decodes it back to exact JSON before the widget
    reads it.

    Every string goes through `default: ''` first: a cleared text setting reaches Liquid as nil,
    and `nil | json` is `null`, which the widget would ignore anyway; this keeps the blob honest.
  {%- endcomment -%}
  {%- capture kitenzo_content -%}
    {
      "heading": {{ section.settings.heading | default: '' | json }},
      "intro": {{ section.settings.intro | default: '' | json }},
      "eyebrow": {{ section.settings.eyebrow | default: '' | json }},
      "showFacets": {{ section.settings.show_facets | json }},
      "facets": {{ section.settings.facets | default: '' | json }},
      "filterLabel": {{ section.settings.filter_label | default: '' | json }},
      "clearFilters": {{ section.settings.clear_filters | default: '' | json }},
      "inCase": {{ section.settings.in_case | default: '' | json }},
      "noMatches": {{ section.settings.no_matches | default: '' | json }},
      "tierNext": {{ section.settings.tier_next | default: '' | json }},
      "tierNextOne": {{ section.settings.tier_next_one | default: '' | json }},
      "tierMax": {{ section.settings.tier_max | default: '' | json }},
      "tierNow": {{ section.settings.tier_now | default: '' | json }},
      "tierRung": {{ section.settings.tier_rung | default: '' | json }},
      "discountPercent": {{ section.settings.discount_percent | default: '' | json }},
      "discountAmount": {{ section.settings.discount_amount | default: '' | json }},
      "discountPrice": {{ section.settings.discount_price | default: '' | json }},
      "surprise": {{ section.settings.surprise | default: '' | json }},
      "surpriseTo": {{ section.settings.surprise_to | default: '' | json }},
      "surpriseFull": {{ section.settings.surprise_full | default: '' | json }},
      "surpriseEmpty": {{ section.settings.surprise_empty | default: '' | json }},
      "surpriseDone": {{ section.settings.surprise_done | default: '' | json }},
      "surpriseShort": {{ section.settings.surprise_short | default: '' | json }},
      "planHeading": {{ section.settings.plan_heading | default: '' | json }},
      "planOneTime": {{ section.settings.plan_one_time | default: '' | json }},
      "planOneTimeNote": {{ section.settings.plan_one_time_note | default: '' | json }},
      "planSave": {{ section.settings.plan_save | default: '' | json }},
      "planSaveLater": {{ section.settings.plan_save_later | default: '' | json }},
      "planPromise": {{ section.settings.plan_promise | default: '' | json }},
      "planFrequency": {{ section.settings.plan_frequency | default: '' | json }},
      "emailLabel": {{ section.settings.email_label | default: '' | json }},
      "emailPlaceholder": {{ section.settings.email_placeholder | default: '' | json }},
      "emailMissing": {{ section.settings.email_missing | default: '' | json }},
      "emailInvalid": {{ section.settings.email_invalid | default: '' | json }},
      "frequencyMissing": {{ section.settings.frequency_missing | default: '' | json }},
      "planGone": {{ section.settings.plan_gone | default: '' | json }},
      "reorderNotice": {{ section.settings.reorder_notice | default: '' | json }},
      "reorderExpired": {{ section.settings.reorder_expired | default: '' | json }},
      "frequencyDay": {{ section.settings.frequency_day | default: '' | json }},
      "frequencyDays": {{ section.settings.frequency_days | default: '' | json }},
      "frequencyWeek": {{ section.settings.frequency_week | default: '' | json }},
      "frequencyWeeks": {{ section.settings.frequency_weeks | default: '' | json }},
      "frequencyMonth": {{ section.settings.frequency_month | default: '' | json }},
      "frequencyMonths": {{ section.settings.frequency_months | default: '' | json }},
      "propertyFrequency": {{ section.settings.property_frequency | default: '' | json }},
      "propertyEmail": {{ section.settings.property_email | default: '' | json }},
      "addToCart": {{ section.settings.add_to_cart | default: '' | json }},
      "addToCartSubscribe": {{ section.settings.add_to_cart_subscribe | default: '' | json }},
      "addToCartReorder": {{ section.settings.add_to_cart_reorder | default: '' | json }},
      "adding": {{ section.settings.adding | default: '' | json }},
      "added": {{ section.settings.added | default: '' | json }},
      "add": {{ section.settings.add | default: '' | json }},
      "remove": {{ section.settings.remove | default: '' | json }},
      "details": {{ section.settings.details | default: '' | json }},
      "close": {{ section.settings.close | default: '' | json }},
      "stepCount": {{ section.settings.step_count | default: '' | json }},
      "stepCountRange": {{ section.settings.step_count_range | default: '' | json }},
      "stepOptional": {{ section.settings.step_optional | default: '' | json }},
      "stepFull": {{ section.settings.step_full | default: '' | json }},
      "bundleFull": {{ section.settings.bundle_full | default: '' | json }},
      "chooseMore": {{ section.settings.choose_more | default: '' | json }},
      "chooseMoreStep": {{ section.settings.choose_more_step | default: '' | json }},
      "soldOut": {{ section.settings.sold_out | default: '' | json }},
      "onlyLeft": {{ section.settings.only_left | default: '' | json }},
      "stockReached": {{ section.settings.stock_reached | default: '' | json }},
      "included": {{ section.settings.included | default: '' | json }},
      "summaryHeading": {{ section.settings.summary_heading | default: '' | json }},
      "summaryEmpty": {{ section.settings.summary_empty | default: '' | json }},
      "caseCount": {{ section.settings.case_count | default: '' | json }},
      "caseCountRange": {{ section.settings.case_count_range | default: '' | json }},
      "total": {{ section.settings.total | default: '' | json }},
      "saving": {{ section.settings.saving | default: '' | json }},
      "unavailable": {{ section.settings.unavailable | default: '' | json }},
      "loadFailed": {{ section.settings.load_failed | default: '' | json }},
      "editNotice": {{ section.settings.edit_notice | default: '' | json }},
      "editMissing": {{ section.settings.edit_missing | default: '' | json }},
      "notAllowed": {{ section.settings.not_allowed | default: '' | json }},
      "retryAdd": {{ section.settings.retry_add | default: '' | json }},
      "afterAdd": {{ section.settings.after_add | default: 'cart' | json }},
      "hidePrices": {{ section.settings.hide_prices | json }}
    }
  {%- endcapture -%}

  <div
    id="kitenzo-{{ section.id }}"
    data-cocktail-case-bundle="{{ resolved_bundle_id | escape }}"
    data-api-key="{{ section.settings.api_key | strip | escape }}"
    data-shop-domain="{{ shop.permanent_domain | escape }}"
    data-country-code="{{ localization.country.iso_code | escape }}"
    data-root-url="{{ routes.root_url | escape }}"
    data-content="{{ kitenzo_content | escape }}"
  ></div>
  <script src="{{ 'kitenzo-cocktail-case.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Kitenzo Cocktail Case",
  "tag": "section",
  "class": "kitenzo-section",
  "settings": [
    {
      "type": "select",
      "id": "bundle_source",
      "label": "Bundle source",
      "options": [
        { "value": "current_product", "label": "This product (automatic)" },
        { "value": "manual", "label": "Selected bundle" }
      ],
      "default": "current_product",
      "info": "\"This product\" shows the bundle of whichever product this template is assigned to, so one template serves every bundle. Use \"Selected bundle\" on a page that is not a product."
    },
    {
      "type": "product",
      "id": "bundle_product",
      "label": "Selected bundle",
      "info": "Used when Bundle source is \"Selected bundle\". Pick the bundle's product."
    },
    {
      "type": "text",
      "id": "bundle_id",
      "label": "Unpublished bundle ID",
      "info": "A draft bundle does not appear in the picker. Paste its ID here to design against it in the theme editor. Leave blank once it is published."
    },
    {
      "type": "paragraph",
      "content": "Made for a mix-a-case bundle: one step with a count across the whole bundle (6 to 24), a tiered discount on the number of products, and optionally a Recurring bundles plan. Tag products with a prefix (Flavor_Fruity) to give shoppers filters. Other bundles render, without the parts they lack."
    },
    {
      "type": "text",
      "id": "api_key",
      "label": "Kitenzo headless API key",
      "info": "From Kitenzo, Settings, Headless. It starts kit_live_ and is public (it ships in the page, like every storefront key), so create it with this store's domains as its allowed origins."
    },
    {"type": "header", "content": "Content"},
    {"type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to use the bundle's name."},
    {"type": "textarea", "id": "intro", "label": "Introduction", "info": "Leave blank to use the bundle's description."},
    {"type": "text", "id": "eyebrow", "label": "Label above the heading", "default": "Mix a case"},
    {"type": "select", "id": "after_add", "label": "After adding to the cart", "options": [{"value": "cart", "label": "Go to the cart"}, {"value": "stay", "label": "Stay on this page"}], "default": "cart", "info": "\"Stay\" suits themes with a cart drawer: the section fires a kitenzo:bundle-added event the drawer can listen for."},
    {"type": "checkbox", "id": "hide_prices", "label": "Hide prices", "default": false},
    {"type": "range", "id": "sticky_offset", "label": "Space for a sticky header", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 88, "info": "How far below the top of the window the case stops while scrolling. Match your theme's sticky header height so the header never covers it."},
    {"type": "header", "content": "Colours"},
    {"type": "color", "id": "accent_color", "label": "Accent", "default": "#d6f65a", "info": "Buttons, the discount ladder and every saving."},
    {"type": "color", "id": "accent_contrast_color", "label": "Text on accent", "default": "#17120e"},
    {"type": "color", "id": "case_color", "label": "Case background", "default": "#17120e"},
    {"type": "color", "id": "case_text_color", "label": "Text on the case", "default": "#fff8ee"},
    {"type": "header", "content": "Filters"},
    {"type": "checkbox", "id": "show_facets", "label": "Show filters", "default": true},
    {"type": "textarea", "id": "facets", "label": "Filters, one per line", "default": "Flavor_ = Flavour\nStrength_ = Strength", "info": "Each line is a tag prefix and the name shoppers see: Flavor_ = Flavour. A product tagged Flavor_Fruity gets a Fruity chip under Flavour. Tags without a listed prefix are ignored."},
    {"type": "text", "id": "filter_label", "label": "Filters, for screen readers", "default": "Filter"},
    {"type": "text", "id": "clear_filters", "label": "Clear filters", "default": "Clear all"},
    {"type": "text", "id": "in_case", "label": "Already in the case", "default": "In your case"},
    {"type": "text", "id": "no_matches", "label": "Nothing matches", "default": "Nothing matches all of those. Try fewer filters."},
    {"type": "header", "content": "Discount ladder"},
    {"type": "text", "id": "tier_next", "label": "Next tier", "default": "Add {count} more to unlock {discount}", "info": "Used when the tier has no custom text of its own in Kitenzo. {count} is how many more, {discount} is what the tier saves."},
    {"type": "text", "id": "tier_next_one", "label": "Next tier, one more", "default": "Add 1 more to unlock {discount}"},
    {"type": "text", "id": "tier_max", "label": "Top tier reached", "default": "Top tier unlocked: {discount} the whole case"},
    {"type": "text", "id": "tier_now", "label": "Discount reached", "default": "{discount} unlocked"},
    {"type": "text", "id": "tier_rung", "label": "Tier size", "default": "{count} cans", "info": "{count} is the number of products the tier needs."},
    {"type": "text", "id": "discount_percent", "label": "A percentage off", "default": "{value}% off", "info": "{value} is the number."},
    {"type": "text", "id": "discount_amount", "label": "An amount off", "default": "{amount} off", "info": "{amount} is the amount, in the shopper's currency."},
    {"type": "text", "id": "discount_price", "label": "A set price", "default": "{amount} a case", "info": "{amount} is the price, in the shopper's currency."},
    {"type": "header", "content": "Surprise me"},
    {"type": "text", "id": "surprise", "label": "Button", "default": "Surprise me"},
    {"type": "text", "id": "surprise_to", "label": "What it fills to", "default": "Fill to {count}", "info": "{count} is the case size it fills to."},
    {"type": "text", "id": "surprise_full", "label": "Case full", "default": "Your case is full. Take one out to make room."},
    {"type": "text", "id": "surprise_empty", "label": "Nothing in stock", "default": "Nothing left in stock to add."},
    {"type": "text", "id": "surprise_done", "label": "After filling", "default": "Added {count}. Swap any you like.", "info": "{count} is how many it added."},
    {"type": "text", "id": "surprise_short", "label": "Filled, stock ran out", "default": "Added {count}. That is all we have in stock right now."},
    {"type": "header", "content": "Subscribe and save"},
    {"type": "text", "id": "plan_heading", "label": "Heading", "default": "Buy once, or join the club"},
    {"type": "text", "id": "plan_one_time", "label": "One-time purchase", "default": "One-time case"},
    {"type": "text", "id": "plan_one_time_note", "label": "One-time, note", "default": "Just this case."},
    {"type": "text", "id": "plan_save", "label": "Plan saving", "default": "An extra {discount}", "info": "{discount} is the plan's discount."},
    {"type": "text", "id": "plan_save_later", "label": "Plan saving from the second order", "default": "{discount} from your second case"},
    {"type": "textarea", "id": "plan_promise", "label": "What joining means", "default": "We email a reminder when it is time, with a one-tap reorder link. Nothing is charged until you reorder.", "info": "Recurring bundles send a reminder email with a reorder link. Nobody is billed automatically, so do not promise deliveries or charges here."},
    {"type": "text", "id": "plan_frequency", "label": "How often", "default": "Remind me"},
    {"type": "text", "id": "email_label", "label": "Email label", "default": "Email for your reminders"},
    {"type": "text", "id": "email_placeholder", "label": "Email placeholder", "default": "you@example.com"},
    {"type": "text", "id": "email_missing", "label": "Email missing", "default": "Enter your email so we can send your reminders."},
    {"type": "text", "id": "email_invalid", "label": "Email not valid", "default": "That email does not look right. Check it and try again."},
    {"type": "text", "id": "frequency_missing", "label": "How often missing", "default": "Choose how often you would like a reminder."},
    {"type": "text", "id": "plan_gone", "label": "Plan no longer available", "default": "That plan is no longer available. Choose another, or buy a one-time case."},
    {"type": "textarea", "id": "reorder_notice", "label": "Reordering from a reminder", "default": "Welcome back. Your member price is on this reorder. Reminders: {frequency}.", "info": "{frequency} is how often the reminders come."},
    {"type": "textarea", "id": "reorder_expired", "label": "Reorder link expired", "default": "That reorder link has expired, so this is a one-time case. You can join the club again below."},
    {"type": "text", "id": "frequency_day", "label": "Every day", "default": "Every day"},
    {"type": "text", "id": "frequency_days", "label": "Every few days", "default": "Every {count} days", "info": "{count} is the number of days."},
    {"type": "text", "id": "frequency_week", "label": "Every week", "default": "Every week"},
    {"type": "text", "id": "frequency_weeks", "label": "Every few weeks", "default": "Every {count} weeks", "info": "{count} is the number of weeks."},
    {"type": "text", "id": "frequency_month", "label": "Every month", "default": "Every month"},
    {"type": "text", "id": "frequency_months", "label": "Every few months", "default": "Every {count} months", "info": "{count} is the number of months."},
    {"type": "text", "id": "property_frequency", "label": "Cart line: how often", "default": "Frequency", "info": "Shown on the cart line and the order."},
    {"type": "text", "id": "property_email", "label": "Cart line: email", "default": "Email", "info": "Shown on the cart line and the order."},
    {"type": "header", "content": "Buttons"},
    {"type": "text", "id": "add_to_cart", "label": "Add to cart", "default": "Add case to cart"},
    {"type": "text", "id": "add_to_cart_subscribe", "label": "Add to cart, joining a plan", "default": "Join the club and add to cart"},
    {"type": "text", "id": "add_to_cart_reorder", "label": "Add to cart, reordering", "default": "Reorder this case"},
    {"type": "text", "id": "adding", "label": "While adding", "default": "Adding…"},
    {"type": "text", "id": "added", "label": "Once added", "default": "Added to your cart"},
    {"type": "text", "id": "add", "label": "Add a product", "default": "Add"},
    {"type": "text", "id": "remove", "label": "Remove a product", "default": "Remove"},
    {"type": "text", "id": "details", "label": "Product details", "default": "Details"},
    {"type": "text", "id": "close", "label": "Close", "default": "Close"},
    {"type": "header", "content": "Steps"},
    {"type": "text", "id": "step_count", "label": "Count, no limit", "default": "{count} chosen", "info": "{count} is how many are chosen."},
    {"type": "text", "id": "step_count_range", "label": "Count, with a limit", "default": "{count} of {range} chosen", "info": "{range} is the step's limit, such as 3–6."},
    {"type": "text", "id": "step_optional", "label": "Optional step", "default": "Optional"},
    {"type": "text", "id": "step_full", "label": "Step is full", "default": "This step is full. Remove one to choose another."},
    {"type": "text", "id": "bundle_full", "label": "Case is full", "default": "Your case is full. Take one out to swap it."},
    {"type": "text", "id": "choose_more", "label": "More needed", "default": "Add {count} more to complete your case"},
    {"type": "text", "id": "choose_more_step", "label": "More needed in a step", "default": "Add {count} more to “{step}”", "info": "{step} is the step's name."},
    {"type": "header", "content": "Products"},
    {"type": "text", "id": "sold_out", "label": "Sold out", "default": "Sold out"},
    {"type": "text", "id": "only_left", "label": "Low stock", "default": "Only {count} left"},
    {"type": "text", "id": "stock_reached", "label": "No more stock", "default": "That is all we have of this one."},
    {"type": "text", "id": "included", "label": "Included product", "default": "Included"},
    {"type": "header", "content": "The case"},
    {"type": "text", "id": "summary_heading", "label": "Heading", "default": "Your case"},
    {"type": "text", "id": "summary_empty", "label": "Empty case", "default": "Your case is empty. Pick a can, or let us surprise you."},
    {"type": "text", "id": "case_count", "label": "Count, no limit", "default": "{count} cans", "info": "{count} is how many are in the case."},
    {"type": "text", "id": "case_count_range", "label": "Count, with a limit", "default": "{count} of {max} cans", "info": "{max} is the most the case holds."},
    {"type": "text", "id": "total", "label": "Total", "default": "Total"},
    {"type": "text", "id": "saving", "label": "Saving", "default": "You save {amount}", "info": "{amount} is the saving, in the shopper's currency."},
    {"type": "header", "content": "Messages"},
    {"type": "text", "id": "unavailable", "label": "Bundle not available", "default": "This bundle is not available right now."},
    {"type": "text", "id": "load_failed", "label": "Bundle failed to load", "default": "We could not load this bundle. Please refresh the page to try again."},
    {"type": "textarea", "id": "edit_notice", "label": "Editing from the cart", "default": "You are editing a case from your cart. Adding it again replaces the one in your cart."},
    {"type": "textarea", "id": "edit_missing", "label": "Edited items no longer available", "default": "Some cans from your saved case are no longer available, so please choose again."},
    {"type": "text", "id": "not_allowed", "label": "Selection not allowed", "default": "This combination cannot be bought as it is. Please change your selection.", "info": "Shown when a bundle rule other than a count (one per product, a price limit) refuses the selection."},
    {"type": "text", "id": "retry_add", "label": "Connection lost while adding", "default": "Press the button again to finish adding it; you will not be charged twice."}
  ],
  "presets": [{ "name": "Kitenzo Cocktail Case" }]
}
{% endschema %}
